rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /listings/{listing} {
      allow read: if true;
      allow write: if true;
    }
    match /system/{doc} {
      allow read: if true;
      allow write: if true;
    }
    match /requests/{request} {
      allow read: if true;
      allow write: if true;
    }
  }
}
